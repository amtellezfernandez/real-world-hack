{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "bunx --bun tsc -b",
    "build": "bun run typecheck && bunx --bun vite build",
    "preview": "bunx --bun vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "bun test",
    "lint": "bunx --bun @biomejs/biome check .",
    "format": "bunx --bun @biomejs/biome format --write .",
    "ci": "bunx --bun @biomejs/biome ci . && bun test && bun run build",
    "contracts:generate": "bunx --bun openapi-typescript ../docs/contracts/openapi.json -o src/modules/api-client/openapi.d.ts",
    "contracts:lint": "bunx --bun @redocly/cli lint ../docs/contracts/openapi.json"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@redocly/cli": "2.30.4",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vite": "8.0.11"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
